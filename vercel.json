{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/resume.pdf",
      "destination": "/DhanunjayaRao_Kadimisetty_Resume.pdf",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/DhanunjayaRao_Kadimisetty_Resume.pdf",
      "permanent": true
    },
    {
      "source": "/cv",
      "destination": "/DhanunjayaRao_Kadimisetty_Resume.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
